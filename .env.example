# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-dev-only
DATABASE_URL=postgres://nrstatlab:dev-only@localhost:5432/nrstatlab
ALLOWED_HOSTS=localhost,127.0.0.1
# The public origin pages are canonical to. Until the domain is bought, the current site.
SITE_ORIGIN=https://nrstatlab.github.io/planning-for-future
# Email: printed to the console in development. In production, the provider's SMTP
# address, e.g. smtp+tls://USER:PASSWORD@smtp.example.com:587 (chosen before staging).
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=StatsTricks360 <no-reply@localhost>
# Google sign-in: shown only when both are set (the OAuth client is made before staging).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The admin asks for a TOTP code when true (always true in production).
ADMIN_OTP_REQUIRED=false
